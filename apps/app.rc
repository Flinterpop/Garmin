// Icon and version information for gview, gsync and fitdump.
#include <windows.h>
#include "resource.h"

IDI_APP ICON "garmin.ico"

#ifndef APP_FILE_DESCRIPTION
#define APP_FILE_DESCRIPTION "Garmin health data tools"
#endif
#ifndef APP_INTERNAL_NAME
#define APP_INTERNAL_NAME "garmin"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
 PRODUCTVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription",  APP_FILE_DESCRIPTION
      VALUE "FileVersion",      APP_VERSION_STRING
      VALUE "InternalName",     APP_INTERNAL_NAME
      VALUE "OriginalFilename", APP_INTERNAL_NAME ".exe"
      VALUE "ProductName",      "Garmin health data tools"
      VALUE "ProductVersion",   APP_VERSION_STRING
      VALUE "LegalCopyright",   "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
