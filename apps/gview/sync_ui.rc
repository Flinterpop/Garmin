// gview's login, sync-progress and first-run dialogs. Keep every string under
// 250 characters: rc.exe truncates at 256 with only a warning /WX does not see.
#include <windows.h>
#include "sync_ui_ids.h"

IDD_LOGIN DIALOGEX 0, 0, 280, 118
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Log in to Garmin Connect"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "", IDC_LOGIN_WHO, 7, 7, 266, 10
  LTEXT "&Email", -1, 7, 26, 50, 10
  EDITTEXT IDC_LOGIN_EMAIL, 60, 24, 213, 13, ES_AUTOHSCROLL
  LTEXT "&Password", -1, 7, 44, 50, 10
  EDITTEXT IDC_LOGIN_PASSWORD, 60, 42, 213, 13, ES_AUTOHSCROLL | ES_PASSWORD
  LTEXT "Your password is sent only to Garmin and is not stored.", IDC_LOGIN_STATUS, 7, 62, 266, 22
  DEFPUSHBUTTON "Log in", IDOK, 166, 96, 50, 14
  PUSHBUTTON "Cancel", IDCANCEL, 223, 96, 50, 14
END

IDD_MFA DIALOGEX 0, 0, 220, 76
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Garmin security code"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Enter the code Garmin just sent you (email or text message).", -1, 7, 7, 206, 18
  EDITTEXT IDC_MFA_CODE, 7, 30, 206, 13, ES_AUTOHSCROLL | ES_NUMBER
  DEFPUSHBUTTON "OK", IDOK, 106, 54, 50, 14
  PUSHBUTTON "Cancel", IDCANCEL, 163, 54, 50, 14
END

IDD_PROGRESS DIALOGEX 0, 0, 360, 220
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION
CAPTION "Garmin"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Working...", IDC_PROGRESS_STATUS, 7, 7, 346, 10
  EDITTEXT IDC_PROGRESS_LOG, 7, 20, 346, 172, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_HSCROLL | ES_AUTOHSCROLL
  PUSHBUTTON "Stop", IDCANCEL, 303, 199, 50, 14
END

IDD_PERSON DIALOGEX 0, 0, 240, 84
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add a person"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "A short name for this person (letters, digits, _ or -). Their Garmin login and data are kept separately under that name.", -1, 7, 7, 226, 26
  EDITTEXT IDC_PERSON_NAME, 7, 38, 226, 13, ES_AUTOHSCROLL
  DEFPUSHBUTTON "Next", IDOK, 126, 62, 50, 14
  PUSHBUTTON "Cancel", IDCANCEL, 183, 62, 50, 14
END

IDD_WELCOME DIALOGEX 0, 0, 290, 118
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Garmin viewer"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Welcome. There is no Garmin data in this folder yet:", -1, 7, 7, 276, 10
  LTEXT "", IDC_WELCOME_FOLDER, 7, 18, 276, 10, SS_PATHELLIPSIS | SS_NOPREFIX
  LTEXT "", IDC_WELCOME_TEXT, 7, 31, 276, 20
  DEFPUSHBUTTON "&Log in to Garmin Connect...", IDC_WELCOME_LOGIN, 7, 58, 276, 16
  PUSHBUTTON "&Copy my data from the previous version", IDC_WELCOME_MIGRATE, 7, 78, 276, 16
  PUSHBUTTON "E&xit", IDCANCEL, 233, 99, 50, 14
END
